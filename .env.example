# Copy this file to .env.local for local dev with `vercel dev` (not
# plain `vite`, so the /api/* endpoints work locally too — see README).
# Set the same keys in Vercel's Project Settings -> Environment
# Variables for Production/Preview/Development.

# --- Client-side (bundled into the browser build, safe to expose) ---
VITE_SANITY_PROJECT_ID=your_project_id
VITE_SANITY_DATASET=production

# --- Server-side only (used by api/*.js, NEVER prefix VITE_) ---

# A Sanity API token with write access. Only api/sanity-write.js
# reads this — it is never bundled into client-side code.
SANITY_WRITE_TOKEN=

# The single password used to log in as the owner (see src/Login.jsx /
# api/auth.js). Pick something long and memorable, not your Sanity
# token.
OWNER_PASSWORD=

# Any long random string — used to sign login sessions. Generate one
# with, e.g., `openssl rand -hex 32`. Changing this instantly logs
# everyone out.
AUTH_SECRET=

# Only needed if you want the API functions to use a different Sanity
# project/dataset than the ones above (rare) — otherwise they fall
# back to VITE_SANITY_PROJECT_ID / VITE_SANITY_DATASET.
# SANITY_PROJECT_ID=
# SANITY_DATASET=
