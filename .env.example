# Copy this file to .env for local dev, and set the same keys in
# Netlify's Site settings -> Environment variables for production.

VITE_SANITY_PROJECT_ID=your_project_id
VITE_SANITY_DATASET=production

# Optional — only set this if you've decided (see README "Writes & security")
# that it's acceptable for this app to write to Sanity directly from the
# browser. Leave it unset to make the app read-only and edit records in
# Sanity Studio instead.
VITE_SANITY_WRITE_TOKEN=
